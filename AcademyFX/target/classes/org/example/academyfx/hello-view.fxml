<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<TabPane minHeight="600.0" minWidth="800.0" tabClosingPolicy="UNAVAILABLE" tabMaxWidth="100.0" tabMinWidth="100.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.academyfx.HelloController">
   <tabs>
      <Tab closable="false" text="Start">
         <content>
            <VBox alignment="CENTER" spacing="5.0">
              <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
              </padding>

              <!--<Label text="Last name:" />
              <TextField fx:id="lastName" promptText="Last Name"/>
              <Label text="First name:" />
              <TextField fx:id="firstName" promptText="First Name"/>
              <Label text="Age:" />
              <DatePicker fx:id="age" promptText="Birth Date"/>
              <Label fx:id="welcomeText"/>
              <Button text="Submit" onAction="#onHelloButtonClick"/>-->

              <ComboBox fx:id="cbDirections" />
              <Button fx:id="load" onAction="#onLoadButtonClick" text="Load" />
              <Button fx:id="check" onAction="#onCheckButtonClick" text="Check" />
            </VBox>
         </content>
      </Tab>
      <Tab closable="false" text="Students">

      </Tab>
      <Tab closable="false" text="Groups">

      </Tab>
     <Tab closable="false" onSelectionChanged="#loadDirections" text="Directions">
         <content>
            <BorderPane prefHeight="200.0" prefWidth="200.0">
               <center>
                  <TableView fx:id="tableDirections" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
               </center>
            </BorderPane>
         </content></Tab>
   </tabs>
</TabPane>
